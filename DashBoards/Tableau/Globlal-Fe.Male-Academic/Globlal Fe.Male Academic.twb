      <column caption='rnk' datatype='string' datatype-customized='true' name='[Calculation_2322731548143824897]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(RANK_DENSE((COUNT([__tableau_internal_object_id__].[total!ranking!tableau_C3B3C68035CE4186B7B7AA03185F6077])), &apos;desc&apos;)-1)'>
