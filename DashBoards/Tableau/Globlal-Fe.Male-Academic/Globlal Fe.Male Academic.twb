    <worksheet name='כמות מדינה'>
      <table>
        <view>
          <datasources>
            <datasource caption='total_ranking_tableau (2020-2026_uns_rnk)' name='federated.037pbpm1gt11zr1fzagqh0493qot' />
          </datasources>
          <datasource-dependencies datasource='federated.037pbpm1gt11zr1fzagqh0493qot'>
            <column caption='אות ראשונה מדינה' datatype='string' name='[Calculation_2322731548140105728]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='left([מדינה],1)' />
            </column>
            <column caption='rnk' datatype='string' datatype-customized='true' name='[Calculation_2322731548143824897]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(RANK_DENSE((COUNT([__tableau_internal_object_id__].[total!ranking!tableau_C3B3C68035CE4186B7B7AA03185F6077])), &apos;desc&apos;)-1)'>
                <table-calc ordering-type='Rows' />
